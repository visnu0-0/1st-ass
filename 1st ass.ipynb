    "#6. Multiplication Table (using while loop)\n",
    "num = int(input(\"Enter a number: \"))\n",
    "print(f\"Multiplication Table of {num}:\")\n",
    "print(\"-\" * 20)\n",
    "i = 1\n",
    "while i <= 10:\n",
    " print(f\"{num} x {i:2} = {num * i}\")\n",
    " i += 1\n"
   ]
