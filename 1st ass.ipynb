   "source": [
    "#1. Find the Largest of Three Numbers\n",
    "a = int(input(\"Enter first number: \"))\n",
    "b = int(input(\"Enter second number: \"))\n",
    "c = int(input(\"Enter third number: \"))\n",
    "if a >= b and a >= c:\n",
    " largest = a\n",
    "elif b >= a and b >= c:\n",
    " largest = b\n",
    "else:\n",
    " largest = c\n",
    "print(f\"The largest number is: {largest}\")\n"
   ]
  },
