   "source": [
    "#5. Sum of First N Natural Numbers (using while loop)\n",
    "n = int(input(\"Enter a positive number N: \"))\n",
    "total = 0\n",
    "i = 1\n",
    "while i <= n:\n",
    " total += i\n",
    " i += 1\n",
    "print(f\"Sum of first {n} natural numbers = {total}\")\n"
   ]
  },
