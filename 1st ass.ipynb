   "source": [
    "#4. Check if a Number is Divisible by Both 5 and 11\n",
    "num = int(input(\"Enter a number: \"))\n",
    "if num % 5 == 0 and num % 11 == 0:\n",
    " print(f\"{num} is divisible by both 5 and 11\")\n",
    "else:\n",
    " print(f\"{num} is NOT divisible by both 5 and 11\")\n"
   ]
  },
