    "#7. Pyramid Pattern\n",
    "rows = 4 # Number of rows in the pyramid\n",
    "for i in range(1, rows + 1):\n",
    " print(\" \" * (rows - i), end=\"\")\n",
    " print(\"*\" * (2 * i - 1))\n",

